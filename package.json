{
	"name": "vim-scrolling",
	"version": "1.0.1",
	"description": "Adds vim-style scrolling (j/k, Ctrl+d/u, gg, G) in reading view when vim key bindings are enabled.",
	"main": "main.js",
	"type": "module",
	"author": "xlongfeng",
	"homepage": "https://github.com/xlongfeng/obsidian-vim-scrolling",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^22.20.0",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^17.7.0",
		"jiti": "2.6.1",
		"obsidian": "^1.12.3",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.62.1"
	}
}
